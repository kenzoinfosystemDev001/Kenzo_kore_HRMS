# =============================================================================
# Kenzo HRMS — Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# ─── DATABASE ────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/kenzo_hrms?sslmode=prefer"

# ─── REDIS ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT / AUTH ──────────────────────────────────────────────
# IMPORTANT: Generate a strong random secret for production
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── APP ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000

# ─── FILE STORAGE ────────────────────────────────────────────
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# ─── EMAIL ───────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@kenzo.com

# ─── AI COPILOT (Future) ────────────────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=

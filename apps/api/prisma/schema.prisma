  description   String?
  type          String    @default("objective") @db.VarChar(50)
  parentGoalId  String?   @map("parent_goal_id") @db.Uuid
  targetValue   Decimal?  @map("target_value") @db.Decimal(10, 2)
  currentValue  Decimal?  @map("current_value") @db.Decimal(10, 2)
  unit          String?   @db.VarChar(50)
  weight        Decimal?  @db.Decimal(5, 2)
  status        String    @default("active") @db.VarChar(50)
  dueDate       DateTime? @map("due_date") @db.Date
  completedAt   DateTime? @map("completed_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  employee    Employee     @relation(fields: [employeeId], references: [id])
  reviewCycle ReviewCycle? @relation(fields: [reviewCycleId], references: [id])
  parentGoal  Goal?        @relation("GoalHierarchy", fields: [parentGoalId], references: [id])
  childGoals  Goal[]       @relation("GoalHierarchy")

  @@index([tenantId])
  @@index([employeeId])
  @@map("goals")
}

model Kpi {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String   @db.VarChar(200)
  description     String?
  category        String?  @db.VarChar(100)
  measurementType String   @map("measurement_type") @db.VarChar(50)
  target          Decimal? @db.Decimal(10, 2)
  weight          Decimal? @db.Decimal(5, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("kpis")
}

model PerformanceReview {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  employeeId    String   @map("employee_id") @db.Uuid
  reviewCycleId String   @map("review_cycle_id") @db.Uuid
  reviewerId    String   @map("reviewer_id") @db.Uuid
  reviewType    String   @map("review_type") @db.VarChar(50)
  ratings       Json?
  overallRating Decimal? @map("overall_rating") @db.Decimal(3, 1)
  strengths     String?
  improvements  String?
  comments      String?
  status        String   @default("pending") @db.VarChar(50)
  submittedAt   DateTime? @map("submitted_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  employee    Employee    @relation("ReviewEmployee", fields: [employeeId], references: [id])
  reviewCycle ReviewCycle @relation(fields: [reviewCycleId], references: [id])
  reviewer    Employee    @relation("ReviewReviewer", fields: [reviewerId], references: [id])

  @@index([tenantId])
  @@index([employeeId])
  @@index([reviewCycleId])
  @@map("performance_reviews")
}

// =============================================================================
// ASSET MANAGEMENT
// =============================================================================

model Asset {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  name          String    @db.VarChar(255)
  assetCode     String    @map("asset_code") @db.VarChar(50)
  category      String    @db.VarChar(100)
  brand         String?   @db.VarChar(100)
  model         String?   @db.VarChar(100)
  serialNumber  String?   @map("serial_number") @db.VarChar(100)
  purchaseDate  DateTime? @map("purchase_date") @db.Date
  purchaseCost  Decimal?  @map("purchase_cost") @db.Decimal(14, 2)
  warrantyExpiry DateTime? @map("warranty_expiry") @db.Date
  status        String    @default("available") @db.VarChar(50)
  specifications Json?
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  assignments AssetAssignment[]

  @@unique([tenantId, assetCode])
  @@index([tenantId])
  @@map("assets")
}

model AssetAssignment {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  assetId               String    @map("asset_id") @db.Uuid
  employeeId            String    @map("employee_id") @db.Uuid
  assignedAt            DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  returnedAt            DateTime? @map("returned_at") @db.Timestamptz
  conditionOnAssignment String?   @map("condition_on_assignment") @db.VarChar(50)
  conditionOnReturn     String?   @map("condition_on_return") @db.VarChar(50)
  assignedBy            String?   @map("assigned_by") @db.Uuid
  notes                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  asset    Asset    @relation(fields: [assetId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([assetId])
  @@index([employeeId])
  @@map("asset_assignments")
}

// =============================================================================
// HELPDESK
// =============================================================================

model Ticket {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  ticketNumber String    @map("ticket_number") @db.VarChar(20)
  category     String    @db.VarChar(50)
  subcategory  String?   @db.VarChar(100)
  subject      String    @db.VarChar(255)
  description  String?
  priority     String    @default("medium") @db.VarChar(20)
  status       String    @default("open") @db.VarChar(50)
  raisedById   String    @map("raised_by_id") @db.Uuid
  assignedToId String?   @map("assigned_to_id") @db.Uuid
  slaDueAt     DateTime? @map("sla_due_at") @db.Timestamptz
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz
  closedAt     DateTime? @map("closed_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  raisedBy   Employee @relation("TicketRaisedBy", fields: [raisedById], references: [id])
  assignedTo Employee? @relation("TicketAssignedTo", fields: [assignedToId], references: [id])
  comments   TicketComment[]

  @@unique([tenantId, ticketNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tickets")
}

model TicketComment {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  content   String
  isInternal Boolean @default(false) @map("is_internal")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_comments")
}

// =============================================================================
// NOTIFICATIONS & ANNOUNCEMENTS
// =============================================================================

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(100)
  title     String    @db.VarChar(255)
  message   String?
  data      Json?
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at") @db.Timestamptz
  actionUrl String?   @map("action_url")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId, isRead])
  @@map("notifications")
}

model Announcement {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  title       String    @db.VarChar(255)
  content     String
  type        String    @default("general") @db.VarChar(50)
  priority    String    @default("normal") @db.VarChar(20)
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz
  authorId    String?   @map("author_id") @db.Uuid
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("announcements")
}

// =============================================================================
// APPROVAL WORKFLOWS
// =============================================================================

model ApprovalWorkflow {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String   @db.VarChar(200)
  entityType String   @map("entity_type") @db.VarChar(100)
  steps      Json
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  requests ApprovalRequest[]

  @@index([tenantId])
  @@map("approval_workflows")
}

model ApprovalRequest {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  workflowId  String   @map("workflow_id") @db.Uuid
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String   @map("entity_id") @db.Uuid
  requestedBy String   @map("requested_by") @db.Uuid
  currentStep Int      @default(0) @map("current_step")
  status      String   @default("pending") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id])
  actions  ApprovalAction[]

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@map("approval_requests")
}

model ApprovalAction {
  id               String   @id @default(uuid()) @db.Uuid
  approvalRequestId String  @map("approval_request_id") @db.Uuid
  step             Int
  approverId       String   @map("approver_id") @db.Uuid
  action           String   @db.VarChar(50) // approved, rejected, delegated
  comments         String?
  actedAt          DateTime @default(now()) @map("acted_at") @db.Timestamptz

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@index([approvalRequestId])
  @@map("approval_actions")
}

// =============================================================================
// DOCUMENT MANAGEMENT
// =============================================================================

model Document {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  name         String    @db.VarChar(255)
  type         String    @db.VarChar(100)
  category     String?   @db.VarChar(100)
  fileUrl      String    @map("file_url")
  fileSize     BigInt?   @map("file_size")
  mimeType     String?   @map("mime_type") @db.VarChar(100)
  version      Int       @default(1)
  description  String?
  tags         String[]
  uploadedBy   String?   @map("uploaded_by") @db.Uuid
  isPublic     Boolean   @default(false) @map("is_public")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, type])
  @@map("documents")
}
